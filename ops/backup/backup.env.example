# Copy to /etc/kreative-norge-backup/backup.env and keep mode 0600/root:root.
# This template intentionally contains no credentials or recovery secret.
BACKUP_ENVIRONMENT=staging
APP_ROOT=/srv/kreative-norge-crm
COMPOSE_FILE=/srv/kreative-norge-crm/docker-compose.staging.yml
COMPOSE_ENV_FILE=/srv/kreative-norge-crm/.env.staging
DATABASE_SERVICE=db
API_SERVICE=api

BACKUP_STATE_ROOT=/var/lib/kreative-norge-backup
WORK_ROOT=/var/lib/kreative-norge-backup/work
STATUS_FILE=/var/lib/kreative-norge-backup/status.json
LOCK_FILE=/run/lock/kreative-norge-backup.lock
RESTORE_GATE_FILE=/var/lib/kreative-norge-backup/restore-smoke.ok

BORG_BIN=borg
BORG_EXPECTED_MAJOR_MINOR=1.2
BORG_REMOTE_PATH=borg-1.2
BORG_REPOSITORY=ssh://REPLACE_STORAGE_BOX_USER@REPLACE_STORAGE_BOX_HOST:23/./kreative-norge
BORG_REPOSITORY_ID=REPLACE_WITH_REPOSITORY_ID_AFTER_INIT
BORG_PASSPHRASE_FILE=/etc/kreative-norge-backup/borg-passphrase
BORG_SSH_KEY=/etc/kreative-norge-backup/storage-box-ed25519
BORG_KNOWN_HOSTS=/etc/kreative-norge-backup/known_hosts
STORAGE_BOX_HOST=REPLACE_STORAGE_BOX_HOST

# Current Django FileFields can resolve under /app/imports and /app/exports in the API container.
# Only explicitly listed host media roots are included when the directories exist.
# Add and restore-verify new roots (such as public-delivery) before activation.
API_CONTAINER_MEDIA_PATHS=/app/imports:/app/exports
HOST_MEDIA_ROOT=/srv/kreative-norge/media
HOST_MEDIA_PATHS=/srv/kreative-norge/media/default:/srv/kreative-norge/media/private:/srv/kreative-norge/media/public
SERVER_CONFIG_PATHS=/srv/kreative-norge-crm/.env.staging:/srv/kreative-norge-crm/docker-compose.staging.yml:/etc/kreative-norge-backup/backup.env:/etc/caddy/Caddyfile:/etc/systemd/system/kreative-norge-backup.service:/etc/systemd/system/kreative-norge-backup.timer:/etc/systemd/system/kreative-norge-backup-verify.service:/etc/systemd/system/kreative-norge-backup-verify.timer

MIN_FREE_BYTES=1073741824
BORG_CHECK_MAX_DURATION=300
RETENTION_DAILY=14
RETENTION_WEEKLY=8
RETENTION_MONTHLY=12
RESTORE_POSTGRES_IMAGE=postgres:16
EXPECTED_DATABASE_TABLES=django_migrations,crm_organization,crm_person
ARCHIVE_PREFIX=kreative-norge
