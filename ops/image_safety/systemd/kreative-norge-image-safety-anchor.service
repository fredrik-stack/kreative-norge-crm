[Unit]
Description=Synchronously verify the current public image safety ledger anchor
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/kreative-norge-image-safety/image-safety.env

[Service]
Type=oneshot
EnvironmentFile=/etc/kreative-norge-image-safety/image-safety.env
ExecStart=/usr/local/lib/kreative-norge-image-safety/image-safety.sh anchor
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kreative-norge-image-safety
TimeoutStartSec=10m
